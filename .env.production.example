# Reference only: configure these variables in IIS/PHP and the Tomcat service.
# PHP does not automatically load .env files.
APP_ENV=production
SUPPLIES_IMPERSONATION_URL=https://eis.nmu.ac.th/supplies/access/impersonate
DB_HOST=192.168.201.3
DB_PORT=1433
DB_USER=
DB_PASSWORD=
DB_ENCRYPT=true
# Temporary for internal SQL with an untrusted certificate; revert after installing a trusted certificate.
DB_TRUST_SERVER_CERTIFICATE=true
DB_EIS=NMU_EIS
DB_ERP=NMU_ERP
DB_DATACENTER=NMU_DATACENTER
DB_DOCS=EIS_DOCS
EIS_DOCS_WS_URL=/eis-docs/ws/notifications
# Set the SAME EIS_DOCS_WS_SECRET in PHP and Tomcat; do not commit its value.
JAVA_API_PORT=8080
EIS_DOCS_PDF_STORAGE=D:/EIS-DOCS/storage/pdf/
