APP_ENV=development
# See .env.local.example / .env.production.example and docs/ENVIRONMENTS.md.

DB_HOST=localhost
DB_PORT=1433
DB_USER=eis_app
DB_PASSWORD=change-me
DB_ENCRYPT=true
# ใช้ true เฉพาะเครื่องพัฒนาที่ SQL Server ใช้ certificate ภายในองค์กร/self-signed
DB_TRUST_SERVER_CERTIFICATE=true

DB_EIS=NMU_EIS
DB_ERP=NMU_ERP
DB_DATACENTER=NMU_DATACENTER

JAVA_API_PORT=8080
JAVA_API_BASE_URL=http://127.0.0.1:8080
EIS_DOCS_PDF_STORAGE=D:/EIS-DOCS/storage/pdf/
